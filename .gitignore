# Jekyll build output
_site/
.jekyll-cache/
.jekyll-metadata
Gemfile.lock

# ---- Private journal: NEVER commit plaintext ----
# The only journal file that may be committed is assets/journal/entries.json,
# which is AES-encrypted. Plain backups are ignored everywhere.
journal-backup*.json
*journal*plaintext*
*明文备份*
assets/journal/*
!assets/journal/entries.json

